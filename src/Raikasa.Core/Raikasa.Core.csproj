<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>$(ProductName).Core</AssemblyName>
    <RootNamespace>$(ProductName).Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Restored for win-x64 as well, so packages.lock.json is the same whether the app publishes with -r win-x64 or the tests restore without it. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts\*.ps1" LogicalName="$(ProductName).Scripts.%(Filename).ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(ProductName).Core.Tests" />
    <InternalsVisibleTo Include="$(ProductName).Fuzz" />
  </ItemGroup>

</Project>
