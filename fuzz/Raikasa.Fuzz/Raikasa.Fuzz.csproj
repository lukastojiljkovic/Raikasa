<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SharpFuzz harness: one executable, one target per run (the FUZZ_TARGET variable). fuzz/run.sh builds, instruments
       the Core library and replays or fuzzes each target; nothing here ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>$(ProductName).Fuzz</AssemblyName>
    <RootNamespace>$(ProductName).Fuzz</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\$(ProductName).Core\$(ProductName).Core.csproj" />
  </ItemGroup>

</Project>
